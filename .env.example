# Bubble Monitor Configuration
# Copy this file to .env and fill in the values

# Database path (SQLite)
BM_DATABASE_PATH=data/bubble_monitor.db

# Cache directory for HTTP responses
BM_CACHE_DIR=.cache

# SEC EDGAR settings
# User-Agent required by SEC (your email)
SEC_USER_AGENT=your-email@example.com

# Rate limits (requests per second)
SEC_RATE_LIMIT=8

# FRED API key (optional, for background bands)
FRED_API_KEY=

# Offline mode (set to 1 to disable network calls)
BM_OFFLINE=0

# Log level (DEBUG, INFO, WARNING, ERROR)
BM_LOG_LEVEL=INFO

# Cohort configuration file
BM_COHORTS_PATH=data/cohorts.yaml

# Premises configuration file
BM_PREMISES_PATH=data/premises.yaml

# Thresholds configuration file
BM_THRESHOLDS_PATH=data/thresholds.yaml
